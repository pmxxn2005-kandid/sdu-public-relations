{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p .vercel-safe && cp deploy/vercel-safe/index.html .vercel-safe/index.html",
  "outputDirectory": ".vercel-safe",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "headers": [{"source":"/(.*)","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"X-Robots-Tag","value":"noindex, nofollow"}]}]
}
